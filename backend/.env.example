# =====================================================================
# Configuración del Entorno — Backend Sistema V (Fastify + MySQL 8)
# Copiar este archivo como `.env` para desarrollo local o Docker Compose
# =====================================================================

# Servidor HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Base de datos MySQL 8.0 (`vacunas`)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme_local_password
DB_NAME=vacunas
DB_CONNECTION_LIMIT=10

# Autenticación JWT y Cookies HttpOnly
# En producción usar secretos aleatorios de al menos 32 caracteres (`openssl rand -hex 32`)
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=8h
COOKIE_SECRET=dev_cookie_secret_change_in_production_32_chars
COOKIE_NAME=sv_access_token
# En producción detrás de HTTPS (Nginx TLS) establecer en `true`
COOKIE_SECURE=false

# CORS (orígenes permitidos separados por coma)
CORS_ORIGIN=http://localhost:4200,http://localhost:80

# Rate Limiting Global
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Rate Limiting Estricto para /api/auth/login (prevención de fuerza bruta)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute

